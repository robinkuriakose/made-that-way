{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "src/data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/builder/:route",
      "destination": "/api/builder?route=:route"
    },
    {
      "source": "/api/player/:route",
      "destination": "/api/player?route=:route"
    },
    {
      "source": "/q/:id",
      "destination": "/api/player?route=share&q=:id"
    },
    {
      "source": "/daily/:day",
      "destination": "/api/player?route=share&day=:day"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
